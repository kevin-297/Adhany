class CliError(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def die(code, msg):
    raise CliError(code, msg)


class Daemon:
    """Connects on first use, so commands that never need the daemon never touch it."""

    def __init__(self, path):
        self.path = path
        self.f = None

    def _connect(self):
        sock = socket.socket(socket.AF_UNIX)
        try:
            sock.connect(self.path)
        except OSError as e:
            die(2, f"cannot connect to {self.path} ({e.strerror}); "
                   "is the daemon running? try: systemctl --user status adhand")
        self.f = sock.makefile("rw", encoding="utf-8", newline="\n")

    def send(self, obj):
        if self.f is None:
            self._connect()
        self.f.write((obj if isinstance(obj, str) else json.dumps(obj)) + "\n")
        self.f.flush()

    def recv(self):
        line = self.f.readline()
        if not line:
            die(2, "the daemon closed the connection")
        return json.loads(line)

    def ask(self, obj):
        self.send(obj)
        r = self.recv()
        if not r.get("ok"):
            die(1, f"{r.get('error')}: {r.get('message')}")
        return r["result"]


# ---------- helpers ----------

def get_tz(name):
    if not name:
        return None                      # system timezone
    from zoneinfo import ZoneInfo
    try:
        return ZoneInfo(name)
    except Exception:
        die(1, f"unknown timezone: {name}")


def hm(ts, tz):
    return D(datetime.fromtimestamp(ts, tz).strftime("%H:%M"))


def span(seconds):
    mins = int(abs(seconds) // 60)
    if mins < 1:
        return T("lt_minute")
    h, m = divmod(mins, 60)
    return T("h_m", h=D(h), m=D(m)) if h else T("m", m=D(m))


def describe(item, now, tz):
    key, ts = item
    when = T("in", t=span(ts - now)) if ts > now else T("ago", t=span(now - ts))
    return T("describe", name=pname(key), time=hm(ts, tz), when=when)


def settings(a):
    """Calculation flags -> the daemon's override/config keys."""
    s = {}
    for attr, key in (("lat", "latitude"), ("lon", "longitude"), ("fajr_angle", "fajr_angle"),
                      ("isha_angle", "isha_angle"), ("asr", "asr")):
        v = getattr(a, attr, None)
        if v is not None:
            s[key] = v
    adj = {}
    for item in getattr(a, "adjust", None) or []:
        name, _, minutes = item.partition("=")
        try:
            adj[name] = int(minutes)
        except ValueError:
            die(1, f"--adjust expects NAME=MINUTES (for example isha=2), got {item!r}")
    if adj:
        s["adjustments"] = adj
    return s


def times(d, day, overrides, neighbors=False):
    req = {"method": "times", "date": day}
    if overrides:
        req["overrides"] = overrides
    if neighbors:
        req["neighbors"] = True
    return d.ask(req)


def timeline(res, with_sunrise=False):
    """Previous Isha, today's prayers, next Fajr, in time order. Items are (key, unix);
    the key is the lowercase English name and is translated only when shown."""
    items = []
    if res.get("previous_isha") is not None:
        items.append(("isha", res["previous_isha"]))
    for p in PRAYERS:
        if p != "sunrise" or with_sunrise:
            items.append((p, res["times"][p]))
    if res.get("next_fajr") is not None:
        items.append(("fajr", res["next_fajr"]))
    return items


def pick(items, now):
    before = [i for i in items if i[1] <= now]
    after = [i for i in items if i[1] > now]
    return (before[-1] if before else None), (after[0] if after else None)


# ---------- day commands ----------

def show_day(a, d, day, with_next):
    tz = get_tz(a.tz)
    res = times(d, day.isoformat(), settings(a), neighbors=with_next)
    if a.json:
        print(json.dumps(res))
        return
    emit(T("day_header", weekday=wd(day.weekday()), date=D(day.isoformat())))
    for p in PRAYERS:
        print("  " + col(pname(p), 8) + col(hm(res["times"][p], tz)))
    if with_next:
        now = time.time()
        _, nxt = pick(timeline(res), now)
        if nxt:
            emit(T("next_label") + describe(nxt, now, tz))


def cmd_today(a, d):
    show_day(a, d, datetime.now(get_tz(a.tz)).date(), with_next=True)


def cmd_date(a, d):
    try:
        day = date.fromisoformat(a.day)
    except ValueError:
        die(1, "date must look like 2026-10-01")
    show_day(a, d, day, with_next=False)


def show_nav(a, d, want_prev, want_next):
    tz = get_tz(a.tz)
    now = time.time()
    res = times(d, datetime.fromtimestamp(now, tz).date().isoformat(), settings(a), neighbors=True)
    prev, nxt = pick(timeline(res, a.with_sunrise), now)
    wanted = {}
    if want_prev:
        wanted["previous"] = prev
    if want_next:
        wanted["next"] = nxt
    for key, item in wanted.items():
        if item is None:
            die(1, f"could not find the {key} prayer")
    if a.json:
        print(json.dumps({k: {"name": v[0], "unix": v[1]} for k, v in wanted.items()}))
    elif want_prev and want_next:
        emit(T("previous_label") + describe(prev, now, tz))
        emit(T("next_label_aligned") + describe(nxt, now, tz))
    else:
        emit(describe(prev if want_prev else nxt, now, tz))


def cmd_next(a, d): show_nav(a, d, False, True)
def cmd_previous(a, d): show_nav(a, d, True, False)
def cmd_now(a, d): show_nav(a, d, True, True)


# ---------- export ----------

def header():
    return [T("h_weekday"), T("h_day"), T("h_month")] + [pname(p) for p in PRAYERS]


def row(res, tz):
    day = date.fromisoformat(res["date"])
    return [wd(day.weekday()), D(day.day), mon(day.month - 1)] + \
           [hm(res["times"][p], tz) for p in PRAYERS]


def print_table(rows, out):
    widths = [max(len(str(r[i])) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        cells = [str(c).rjust(w) if i == 1 else str(c).ljust(w)
                 for i, (c, w) in enumerate(zip(r, widths))]
        print("  ".join(cells).rstrip(), file=out)


def make_ics(results):
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    lines = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//adhan//EN"]
    for r in results:
        for p in PRAYERS:
            if p == "sunrise":
                continue
            t = datetime.fromtimestamp(r["times"][p], timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            lines += ["BEGIN:VEVENT", f"UID:{r['date']}-{p}@adhan", f"DTSTAMP:{stamp}",
                      f"DTSTART:{t}", f"DTEND:{t}", f"SUMMARY:{pname(p)}", "END:VEVENT"]
    lines.append("END:VCALENDAR")
    return "\r\n".join(lines) + "\r\n"


MAX_DAYS = 3660      # 10 years of 366 days


def export_days(a, tz):
    if a.date_from or a.date_to:
        if a.year or a.month:
            die(1, "--from/--to cannot be combined with --year or --month")
        if not (a.date_from and a.date_to):
            die(1, "--from and --to must be used together")
        try:
            start, end = date.fromisoformat(a.date_from), date.fromisoformat(a.date_to)
        except ValueError:
            die(1, "--from and --to must look like 2026-10-01")
        if end < start:
            die(1, "--to is before --from")
    else:
        year = a.year or datetime.now(tz).year
        start = date(year, a.month or 1, 1)
        end = date(year, 12, 31) if not a.month or a.month == 12 \
            else date(year, a.month + 1, 1) - timedelta(days=1)
    n = (end - start).days + 1
    if n > MAX_DAYS:
        die(1, f"that range is {n} days and the limit is {MAX_DAYS} (about 10 years). "
               "Run separate exports for longer periods, for example one command per "
               "decade, each with its own -o FILE.")
    return [start + timedelta(days=i) for i in range(n)]


def cmd_export(a, d):
    tz = get_tz(a.tz)
    days = export_days(a, tz)
    ov = settings(a)

    results = []
    for i in range(0, len(days), CHUNK):          # write a chunk, then read its replies
        chunk = days[i:i + CHUNK]
        for day in chunk:
            req = {"id": day.isoformat(), "method": "times", "date": day.isoformat()}
            if ov:
                req["overrides"] = ov
            d.send(req)
        for day in chunk:
            r = d.recv()
            if r.get("id") != day.isoformat():
                die(1, "replies arrived out of order; aborting")
            if not r.get("ok"):
                die(1, f"{day}: {r.get('error')}: {r.get('message')} (nothing written)")
            results.append(r["result"])

    # Files get logical text. CSV in Arabic gets a BOM so Excel reads it as UTF-8.
    enc = "utf-8-sig" if (a.format == "csv" and UI.lang == "ar") else "utf-8"
    out = open(a.output, "w", newline="", encoding=enc) if a.output else sys.stdout
    try:
        if a.format == "table":
            rows = [header()] + [row(r, tz) for r in results]
            if out is sys.stdout and UI.bidi:       # fix each cell before print_table measures it
                rows = [[fix(str(c)) for c in r] for r in rows]
            print_table(rows, out)
        elif a.format == "csv":
            w = csv.writer(out)
            w.writerow(header())
            w.writerows(row(r, tz) for r in results)
        elif a.format == "json":
            json.dump(results, out, indent=2)
            out.write("\n")
        else:
            out.write(make_ics(results))
    finally:
        if a.output:
            out.close()
            print(f"wrote {len(results)} days to {a.output}", file=sys.stderr)


# ---------- daemon / config ----------

def show_config(a, cfg):
    saved = load_client_config()
    client = {"lang": saved.get("lang", "en"), "digits": saved.get("digits", "islamic")}
    if a.json:
        print(json.dumps(cfg if cfg is not None else client, indent=2))
        return
    for k, v in {**(cfg or {}), **client}.items():
        if k == "adjustments":
            v = ", ".join(f"{n}={m:+d}" for n, m in v.items()) or "none"
        print(f"{k:<12}{v}")


def cmd_config(a, d):
    show_config(a, d.ask({"method": "config.get"}))


def cmd_config_set(a, d):
    vals = settings(a)
    if a.neighbors is not None:
        vals["neighbors"] = a.neighbors == "true"
    ui = {k: getattr(a, k) for k in ("lang", "digits") if getattr(a, k, None)}
    if not vals and not ui:
        die(1, "nothing to set; try: adhan config set --lat 34.01 --lon -6.83 (or --lang ar)")
    cfg = d.ask({"method": "config.set", "values": vals}) if vals else None   # daemon first: it validates
    if ui:
        save_client_config(ui)                 # language and digits are saved client-side
    show_config(a, cfg)


def cmd_ping(a, d):
    d.ask({"method": "ping"})
    print("pong")


def cmd_raw(a, d):
    d.send(a.request)
    r = d.recv()
    print(json.dumps(r))
    sys.exit(0 if r.get("ok") else 1)


# ---------- waybar module ----------

ELAPSED_WINDOW = 30 * 60     # after a prayer begins, the bar keeps showing it for this long
COUNTDOWN_WINDOW = 60 * 60   # before a prayer, the bar shows a countdown for this long
FLIP_SECONDS = 10            # how long a click shows the other prayer
HIGHLIGHT = "#89b4fa"        # tooltip colour of the next prayer's row


def flip_file():
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "adhan-waybar-flip")


def is_flipped(now):
    try:
        with open(flip_file()) as f:
            return float(f.read()) > now
    except (OSError, ValueError):
        return False


def view_item(prev, nxt, now, flipped):
    """The prayer the bar shows: the previous one while it is fresh, otherwise the next.
    A flip swaps the two."""
    show_prev = prev is not None and now - prev[1] < ELAPSED_WINDOW
    if flipped:
        show_prev = not show_prev
    return (prev if show_prev else nxt) or prev or nxt


def render(item, now, tz):
    """(text, state) for one prayer; the format depends on that prayer's own distance."""
    key, ts = item
    name = pname(key)
    if ts <= now:
        elapsed = now - ts
        if elapsed < ELAPSED_WINDOW:        # rounds up: runs fast
            return T("bar_elapsed", name=name, n=D(f"{math.ceil(elapsed / 60):02d}")), "elapsed"
        return T("bar_time", name=name, time=hm(ts, tz)), "past"
    remaining = ts - now
    if remaining < COUNTDOWN_WINDOW:        # rounds down: runs fast
        return T("bar_countdown", name=name, n=D(f"{int(remaining // 60):02d}")), "countdown"
    return T("bar_time", name=name, time=hm(ts, tz)), "next"


def tooltip_rows(res, day, nxt, tz):
    """(heading, [(name, time, is_next)]) as plain logical text."""
    head = T("tip_date", wd=wd(day.weekday(), True), d=D(f"{day.day:02d}"),
             mon=mon(day.month - 1, True), y=D(day.year))
    rows = [(pname(p), hm(res["times"][p], tz),
             bool(nxt and nxt[0] == p and nxt[1] == res["times"][p]))     # not tomorrow's Fajr
            for p in PRAYERS]
    return head, rows


def build_tooltip(res, day, nxt, tz):
    head, rows = tooltip_rows(res, day, nxt, tz)
    lines = [head]
    for name, t, is_next in rows:
        line = f"{name:<9}{t}"
        lines.append(f'<span foreground="{HIGHLIGHT}">{line}</span>' if is_next else line)
    return "\n".join(lines)


def waybar_fetch(d, now, tz):
    day = datetime.fromtimestamp(now, tz).date()
    res = times(d, day.isoformat(), None, neighbors=True)
    prev, nxt = pick(timeline(res), now)
    return res, day, prev, nxt


def waybar_payload(res, day, prev, nxt, now, tz, flipped):
    item = view_item(prev, nxt, now, flipped)
    if item is None:
        die(1, "no prayer times found")
    text, state = render(item, now, tz)
    return {"text": text, "alt": item[0],
            "class": [state] + (["flipped"] if flipped else []),
            "tooltip": build_tooltip(res, day, nxt, tz)}


def cmd_waybar_show(a, d):
    try:
        tz = get_tz(a.tz)
        now = time.time()
        payload = waybar_payload(*waybar_fetch(d, now, tz), now, tz, is_flipped(now))
    except CliError as e:                  # always print valid JSON so the bar never shows a traceback
        payload = {"text": T("bar_offline") if e.code == 2 else T("bar_error"), "alt": "offline",
                   "class": ["offline"], "tooltip": html.escape(str(e))}
    print(json.dumps(payload))


def cmd_waybar_flip(a, d):
    now = time.time()
    try:
        if is_flipped(now):                # a second click cancels the flip
            os.remove(flip_file())
            return
        with open(flip_file(), "w") as f:
            f.write(str(now + FLIP_SECONDS))
    except OSError as e:
        die(1, f"cannot use {flip_file()}: {e.strerror}")
    # Waybar re-runs `show` right after this command; this wakes it again when the flip ends.
    subprocess.Popen(["sh", "-c", f"sleep {FLIP_SECONDS + 0.3}; pkill -RTMIN+{a.signal} waybar"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def parse_at(text, tz):
    try:
        dt = datetime.fromisoformat(text)
    except ValueError:
        die(1, "--at must look like 2026-10-01T12:21:40")
    if dt.tzinfo is None and tz:
        dt = dt.replace(tzinfo=tz)
    return dt.timestamp()


def cmd_waybar_preview(a, d):
    tz = get_tz(a.tz)
    now = parse_at(a.at, tz) if a.at else time.time()
    res, day, prev, nxt = waybar_fetch(d, now, tz)
    if a.view == "tooltip":
        head, rows = tooltip_rows(res, day, nxt, tz)
        emit(head)
        for name, t, is_next in rows:
            line = col(name, 9) + col(t)
            print(f"\033[34m{line}\033[0m" if is_next and sys.stdout.isatty() else line)
        return
    p = waybar_payload(res, day, prev, nxt, now, tz, flipped=(a.view == "flipped"))
    print(f"{fx(p['text'])}    [icon: {p['alt']}, class: {' '.join(p['class'])}]")


# ---------- argument parsing ----------

class Parser(argparse.ArgumentParser):
    def error(self, message):            # argparse exits 2 by default; 2 is reserved for "no daemon"
        self.print_usage(sys.stderr)
        print(f"{self.prog}: error: {message}", file=sys.stderr)
        sys.exit(1)


def build_parser():
    conn = argparse.ArgumentParser(add_help=False)
    conn.add_argument("--socket", metavar="PATH",
                      help="daemon socket (default: $ADHAND_SOCKET, then $XDG_RUNTIME_DIR/adhand.sock)")
    conn.add_argument("--tz", metavar="NAME",
                      help="show times in this IANA timezone (default: system timezone)")
    conn.add_argument("--lang", choices=list(STRINGS),
                      help="language of the output (default: $ADHAN_LANG, then the saved setting, then en)")
    conn.add_argument("--digits", choices=DIGIT_STYLES,
                      help="digit style in Arabic output (default: $ADHAN_DIGITS, saved setting, then islamic 0-9)")
    conn.add_argument("--bidi", choices=BIDI_MODES,
                      help="kitty Arabic fix for terminal text: auto = only on a kitty terminal "
                           "(default: $ADHAN_BIDI, then auto)")
    common = argparse.ArgumentParser(add_help=False, parents=[conn])
    common.add_argument("--json", action="store_true", help="print JSON instead of text")

    calc = argparse.ArgumentParser(add_help=False)
    g = calc.add_argument_group("calculation settings")
    g.add_argument("--lat", type=float, metavar="DEG", help="latitude")
    g.add_argument("--lon", type=float, metavar="DEG", help="longitude")
    g.add_argument("--fajr-angle", type=float, metavar="DEG", help="Fajr sun angle")
    g.add_argument("--isha-angle", type=float, metavar="DEG", help="Isha sun angle")
    g.add_argument("--asr", choices=["standard", "hanafi"], help="Asr shadow rule")
    g.add_argument("--adjust", action="append", metavar="NAME=MIN",
                   help="shift a prayer by whole minutes, e.g. isha=2 (repeatable)")

    main = Parser(
        prog="adhan", description="Talk to the adhand daemon: prayer times, countdowns and exports.",
        epilog=EXAMPLES, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = main.add_subparsers(dest="cmd", metavar="COMMAND", title="commands")

    def add(name, helptext, func, parents):
        p = sub.add_parser(name, help=helptext, description=helptext, parents=parents)
        p.set_defaults(func=func)
        return p

    both = [common, calc]
    add("today", "today's times and the next prayer (default command)", cmd_today, both)
    p = add("date", "times for one date", cmd_date, both)
    p.add_argument("day", metavar="YYYY-MM-DD")
    for name, func, text in (("next", cmd_next, "the next prayer with a countdown"),
                             ("previous", cmd_previous, "the previous prayer and how long ago it was"),
                             ("now", cmd_now, "both the previous and the next prayer")):
        p = add(name, text, func, both)
        p.add_argument("--with-sunrise", action="store_true", help="count sunrise as a prayer time")

    p = add("export", "export times for a year, a month, or a date range (up to 10 years)",
            cmd_export, both)
    p.add_argument("--year", type=int, help="year to export (default: this year)")
    p.add_argument("--month", type=int, choices=range(1, 13), metavar="1-12",
                   help="export only this month")
    p.add_argument("--from", dest="date_from", metavar="YYYY-MM-DD",
                   help="first day of a custom range (use with --to; replaces --year/--month)")
    p.add_argument("--to", dest="date_to", metavar="YYYY-MM-DD",
                   help="last day of a custom range, inclusive; at most 3660 days (10 years)")
    p.add_argument("--format", choices=["table", "csv", "json", "ics"], default="table",
                   help="table and csv have columns Weekday, Day, Month and the six times "
                        "(default: table); ics has the five prayers, sunrise excluded")
    p.add_argument("-o", "--output", metavar="FILE", help="write to FILE instead of the terminal")

    p = add("config", "show the daemon's saved settings", cmd_config, [common])
    csub = p.add_subparsers(dest="config_cmd", metavar="set")
    sp = csub.add_parser("set", help="change the daemon's saved settings",
                         description="Change the daemon's saved settings. Only the flags you pass change.",
                         parents=both)
    sp.add_argument("--neighbors", choices=["true", "false"],
                    help="default for including previous Isha and next Fajr in replies")
    sp.set_defaults(func=cmd_config_set)

    wp = add("waybar", "status bar module for Waybar (show, flip, preview)", None, [])
    wp.set_defaults(func=lambda a, d: wp.print_help())
    wsub = wp.add_subparsers(dest="waybar_cmd", metavar="COMMAND", title="commands")
    sp = wsub.add_parser("show", parents=[conn],
                         help="print the module's JSON line (Waybar's exec command)",
                         description="Print one JSON line with text, alt, class and tooltip for Waybar.")
    sp.set_defaults(func=cmd_waybar_show)
    sp = wsub.add_parser("flip",
                         help="show the other prayer for 10 seconds (Waybar's on-click command)",
                         description="Show the other prayer for 10 seconds; a second click cancels.")
    sp.add_argument("--signal", type=int, default=8, metavar="N",
                    help="the module's Waybar signal number, used to refresh it when the flip "
                         "ends (default: 8; must match \"signal\" in the Waybar config)")
    sp.set_defaults(func=cmd_waybar_flip)
    sp = wsub.add_parser("preview", parents=[conn],
                         help="print what the bar or tooltip would show, in plain text",
                         description="Print a view as plain text without touching any state. "
                                     "Use --at to pretend it is another time.")
    sp.add_argument("view", choices=["normal", "flipped", "tooltip"])
    sp.add_argument("--at", metavar="YYYY-MM-DDTHH:MM:SS",
                    help="pretend it is this local time, to check the edge cases")
    sp.set_defaults(func=cmd_waybar_preview)

    add("ping", "check that the daemon answers", cmd_ping, [common])
    p = add("raw", "send one raw JSON request and print the reply", cmd_raw, [common])
    p.add_argument("request", metavar="JSON", help="for example '{\"method\":\"ping\"}'")
    return main


def main():
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)   # quiet exit for `adhan export | head`
    argv = sys.argv[1:]
    if not argv or (argv[0].startswith("-") and argv[0] not in ("-h", "--help")):
        argv = ["today"] + argv                      # bare `adhan` means `adhan today`
    a = build_parser().parse_args(argv)
    for stream in (sys.stdout, sys.stderr):          # Arabic must not depend on the locale
        try:
            stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError):
            pass
    path = (getattr(a, "socket", None) or os.environ.get("ADHAND_SOCKET")
            or os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "adhand.sock"))
    try:
        setup_ui(a)
        a.func(a, Daemon(path))
    except CliError as e:
        print(f"adhan: {e}", file=sys.stderr)
        sys.exit(e.code)


if __name__ == "__main__":
    main()
