def wd(i, short=False):
    return STRINGS[UI.lang]["weekdays_short" if short else "weekdays"][i]


def mon(i, short=False):
    return STRINGS[UI.lang]["months_short" if short else "months"][i]


_INDIC = str.maketrans("0123456789", "\u0660\u0661\u0662\u0663\u0664\u0665\u0666\u0667\u0668\u0669")


def D(value):
    """Digits in the chosen style (Arabic only); anything else passes through unchanged."""
    if UI.lang == "ar" and UI.digits == "indian":
        return str(value).translate(_INDIC)
    return value


# ---------- Arabic in kitty (trimmed from ArKitty's arfix.py) ----------
# Kitty draws one cell at a time with no joining, and draws every word that contains
# Arabic right to left. fix() reshapes the letters, then pre-flips what kitty would
# reverse, then reverses the word order. Needs arabic-reshaper, imported on first use,
# and only when UI.bidi is on, so Waybar, pipes, --json and English never load it.
# Keep in step with ArKitty (digits mode "split", punctuation mode "move").

_ARB = "\u0600-\u06FF\u0750-\u077F\uFB50-\uFDFF\uFE70-\uFEFF"
_AD = "\u0660-\u0669\u06F0-\u06F9"                    # Arabic-Indic and Persian digits
_APUNCT = "\u060C\u061B\u061F"
_MARKS = re.compile("[\u200e\u200f\u061c\u202a-\u202e\u2066-\u2069]")   # invisible bidi marks
_LETTERS = f"(?:(?![0-9{_AD}])[{_ARB}])"
_RUNS = re.compile(f"{_LETTERS}+|(?:(?!{_LETTERS}).)+", re.S)
_HAS = re.compile(_LETTERS)
_LATIN = re.compile("[A-Za-z]")
_ARDIG = re.compile(f"[{_AD}]")
_NUM = re.compile(rf"([{_AD}]+(?:[:.,/\u066B\u066C][{_AD}]+)*)")      # a number: 12:30 , 3.5
_ADRUN = re.compile(f"[{_AD}]+")
_EDGE = re.compile(rf"^([{_APUNCT}]*)(.*?)([{_APUNCT}]*)$", re.S)
_reshaper_obj = None


def _reshaper():
    global _reshaper_obj
    if _reshaper_obj is None:
        try:
            import arabic_reshaper
        except ImportError:
            die(1, "Arabic in kitty needs the arabic-reshaper package for the python3 that runs "
                    "adhan (Arch: yay -S python-arabic-reshaper; elsewhere: pip install arabic-reshaper), "
                    "or run with --bidi off")
        _reshaper_obj = arabic_reshaper.ArabicReshaper(configuration={
            "delete_harakat": True,       # diacritics attach to the wrong cell after reordering
            "delete_tatweel": True,       # the stretch bar renders as '_' in a cell grid
            "support_ligatures": True})
    return _reshaper_obj


def _flip_runs(word):
    """In a token mixing Arabic with other stuff (12X, -42X), reverse each non-Arabic run
    in place: kitty draws the whole token right to left."""
    parts = _RUNS.findall(word)
    if len(parts) > 1 and any(_HAS.search(p) for p in parts):
        return "".join(p if _HAS.search(p) else p[::-1] for p in parts)
    return word


def _one(w):
    if _ARDIG.search(w):                  # kitty reverses each Arabic-Indic digit run in place
        pieces = [p for p in _NUM.split(w) if p]
        out = [_ADRUN.sub(lambda m: m.group()[::-1], p) if _NUM.fullmatch(p) else _flip_runs(p)
               for p in pieces]
        if _HAS.search(w):                # next to letters, the pieces swap sides
            out.reverse()
        return "".join(out)
    return _flip_runs(w)


def _punct(word):
    """Arabic punctuation glued to a word moves to the other end."""
    lead, core, trail = _EDGE.match(word).groups()
    return trail + core + lead if (lead or trail) and core else word


def _reorder(words):
    """Reverse the word order, keeping consecutive Latin words in their own order."""
    is_latin = lambda w: bool(_LATIN.search(w)) and not _HAS.search(w)
    groups = []
    for w in words:
        if groups and is_latin(w) and is_latin(groups[-1][-1]):
            groups[-1].append(w)
        else:
            groups.append([w])
    return " ".join(" ".join(g) for g in reversed(groups))


def fix(line):
    """One logical line of text -> the string to print so kitty shows it correctly."""
    line = _MARKS.sub("", line)
    if not _HAS.search(line) and not _ARDIG.search(line):
        return line                       # nothing to fix; arabic-reshaper is not loaded
    words = [_one(_punct(w)) for w in _reshaper().reshape(line).split()]
    return _reorder(words)


def fx(text):
    """Human-facing text for the terminal: fixed when UI.bidi is on, untouched otherwise."""
    if not UI.bidi:
        return text
    return "\n".join(fix(line) for line in str(text).split("\n"))


def emit(text=""):
    """The one print for human-facing lines of logical text."""
    print(fx(text))


def col(text, width=0):
    """A table cell: fix it first, then pad, because reshaping changes the length."""
    return fx(str(text)).ljust(width)


def in_kitty():
    return bool(os.environ.get("KITTY_WINDOW_ID")) or os.environ.get("TERM") == "xterm-kitty"


# ---------- client settings (language etc.) ----------
# Presentation only, so it lives here and not in the daemon's config.

def client_config_path():
    return os.environ.get("ADHAN_CONFIG") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "adhan", "config.json")


def load_client_config():
    path = client_config_path()
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        die(1, f"cannot read {path}: {e}")
    if not isinstance(data, dict):
        die(1, f"{path} must contain a JSON object")
    return data


def save_client_config(updates):
    path = client_config_path()
    data = load_client_config()
    data.update(updates)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + ".tmp", "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        os.replace(path + ".tmp", path)
    except OSError as e:
        die(1, f"cannot write {path}: {e.strerror}")


def norm_lang(value, source):
    code = str(value).replace("_", "-").split("-")[0].split(".")[0].lower()   # ar_MA.UTF-8 -> ar
    if code not in STRINGS:
        die(1, f"unknown language {value!r} (from {source}); available: {', '.join(STRINGS)}")
    return code


def setup_ui(a):
    """Flag, then environment, then saved setting, then the default."""
    saved, env = load_client_config(), os.environ
    path = client_config_path()
    for value, source in ((getattr(a, "lang", None), "--lang"), (env.get("ADHAN_LANG"), "ADHAN_LANG"),
                          (saved.get("lang"), path)):
        if value:
            UI.lang = norm_lang(value, source)
            break
    for value, source in ((getattr(a, "digits", None), "--digits"), (env.get("ADHAN_DIGITS"), "ADHAN_DIGITS"),
                          (saved.get("digits"), path)):
        if value:
            if value not in DIGIT_STYLES:
                die(1, f"unknown digit style {value!r} (from {source}); use {' or '.join(DIGIT_STYLES)}")
            UI.digits = value
            break
    mode = getattr(a, "bidi", None) or env.get("ADHAN_BIDI") or "auto"
    if mode not in BIDI_MODES:
        die(1, f"unknown bidi mode {mode!r}; use {', '.join(BIDI_MODES)}")
    UI.bidi = UI.lang == "ar" and (mode == "on" or (mode == "auto" and sys.stdout.isatty() and in_kitty()))

